{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": { "includes": ["web/src/**", "web/test/**", "web/*.css", "web/*.html", "scripts/**"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "error" },
      "suspicious": { "noExplicitAny": "error" }
    }
  }
}
